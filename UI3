local function viewport()
    local cam = workspace.CurrentCamera
    if cam then return cam.ViewportSize end
    return Vector2.new(1280, 720)
end

local function fitScale(w, h, margin)
    local vp = viewport()
    margin = margin or 24
    local f = math.min(1, (vp.X - margin) / w, (vp.Y - margin) / h)
    return math.max(0.4, f)
end

local function commas(n)
    local s = tostring(math.floor(n))
    local out = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
    if out:sub(1, 1) == "," then out = out:sub(2) end
    return out
end

local function snapshot(root)
    local snap = {}
    local function add(o)
        local p = {}
        if o:IsA("GuiObject") then
            p.BackgroundTransparency = o.BackgroundTransparency
            if o:IsA("TextLabel") or o:IsA("TextButton") or o:IsA("TextBox") then p.TextTransparency = o.TextTransparency end
            if o:IsA("ImageLabel") or o:IsA("ImageButton") then p.ImageTransparency = o.ImageTransparency end
            if o:IsA("ScrollingFrame") then p.ScrollBarImageTransparency = o.ScrollBarImageTransparency end
        elseif o:IsA("UIStroke") then
            p.Transparency = o.Transparency
        else
            return
        end
        snap[#snap + 1] = { o = o, p = p }
    end
    add(root)
    for _, d in ipairs(root:GetDescendants()) do add(d) end
    return snap
end
local function fadeSnap(snap, hidden, info)
    for _, e in ipairs(snap) do
        local goal = {}
        for k, v in pairs(e.p) do goal[k] = hidden and 1 or v end
        if info then tween(e.o, info, goal) else for k, v in pairs(goal) do pcall(function() e.o[k] = v end) end end
    end
end

