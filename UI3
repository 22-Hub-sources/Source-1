    for i, name in ipairs(ThemeOrder) do
        local p = Themes[name]
        local c = new("TextButton", {
            BackgroundColor3 = p.Bg, BorderSizePixel = 0, Text = "", AutoButtonColor = false, LayoutOrder = i,
        }, grid)
        corner(c, 10)
        local cs = new("UIStroke", { Color = p.Stroke, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, c)
        local g = new("UIGradient", { Rotation = 90, Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(190, 190, 190)) }, c)
        local sw = new("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(60, 12) }, c)
        new("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder }, sw)
        for j, col in ipairs({ p.Accent, p.Accent2, p.Panel }) do
            local s = new("Frame", { Size = UDim2.fromOffset(12, 12), BackgroundColor3 = col, BorderSizePixel = 0, LayoutOrder = j }, sw)
            round(s)
        end
        new("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 30), Size = UDim2.new(1, -20, 0, 16),
            Font = Enum.Font.GothamBold, TextSize = 13, TextColor3 = p.Text, Text = name, TextXAlignment = Enum.TextXAlignment.Left,
        }, c)
        new("TextLabel", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(10, 47), Size = UDim2.new(1, -20, 0, 14),
            Font = Enum.Font.Gotham, TextSize = 11, TextColor3 = p.Sub, Text = p.Hint, TextXAlignment = Enum.TextXAlignment.Left,
            TextTruncate = Enum.TextTruncate.AtEnd,
        }, c)
        local check = new("TextLabel", {
            AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 8), Size = UDim2.fromOffset(18, 18),
            BackgroundColor3 = p.Accent, Text = "", Visible = false,
        }, c)
        round(check)
        local inner = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(6, 6), BackgroundColor3 = p.OnAccent, BorderSizePixel = 0 }, check)
        round(inner)
        local sc = new("UIScale", { Scale = 1 }, c)
        cards[name] = { c = c, s = cs, check = check, p = p }
        c.MouseEnter:Connect(function() tween(sc, FAST, { Scale = 1.03 }) end)
        c.MouseLeave:Connect(function() tween(sc, FAST, { Scale = 1 }) end)
        c.MouseButton1Click:Connect(function()
            tween(sc, FAST, { Scale = 0.96 })
            task.delay(0.1, function() tween(sc, BOUNCE, { Scale = 1 }) end)
            onPick(name)
        end)
        local _ = g
    end
    local function paint()
        for name, e in pairs(cards) do
            local on = (name == Settings.Theme)
            e.check.Visible = on
            tween(e.s, FAST, { Color = on and e.p.Accent or e.p.Stroke, Thickness = on and 2 or 1 })
        end
    end
    paint()
    return paint
end

