local function tween(obj, info, props)
    if not obj then return end
    if not Settings.Motion then
        for k, v in pairs(props) do pcall(function() obj[k] = v end) end
        return
    end
    local ok, t = pcall(function() return TweenService:Create(obj, info, props) end)
    if ok and t then t:Play() end
    return t
end

local Bound, Hooks = {}, {}
local function bind(obj, prop, key)
    Bound[#Bound + 1] = { obj, prop, key }
    pcall(function() obj[prop] = Theme[key] end)
    return obj
end
local function onTheme(anchor, fn)
    Hooks[#Hooks + 1] = { anchor, fn }
    pcall(fn, true)
end

local function new(class, props, parent)
    local o = Instance.new(class)
    local th
    for k, v in pairs(props or {}) do
        if k == "_theme" then th = v else o[k] = v end
    end
    if th then for prop, key in pairs(th) do bind(o, prop, key) end end
    if parent then o.Parent = parent end
    return o
end

