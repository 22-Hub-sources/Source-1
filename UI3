function Library:KeySystem(cfg)
    cfg = cfg or {}
    local REAL_KEY = tostring(cfg.Key or ""):lower()
    local SAVE_FILE = cfg.SaveFile
    local LINK = cfg.Discord or DISCORD_LINK
    local function trim(s) return (tostring(s):gsub("^%s+", ""):gsub("%s+$", "")) end

    if SAVE_FILE then
        local okRead, saved = pcall(function()
            if isfile and readfile and isfile(SAVE_FILE) then return readfile(SAVE_FILE) end
        end)
        if okRead and type(saved) == "string" and trim(saved):lower() == REAL_KEY then return true end
    end

    local passed, done = false, false
    local ok = pcall(function()
        local W, H = 380, 356
        local gui, card, open, close = overlayCard("22HubKey", 1000, W, H)
        local badge = logoBadge(card, 56, 14)
        badge.AnchorPoint = Vector2.new(0.5, 0)
        badge.Position = UDim2.new(0.5, 0, 0, 26)
        centerLabel(card, "Enter your key", 94, 22, "Text", Enum.Font.GothamBold)
        centerLabel(card, "22 Hub  ·  " .. tostring(cfg.Title or ""), 124, 13, "Sub", Enum.Font.GothamMedium)

        local copy = cardButton(card, "Copy Discord link", false, {
            Position = UDim2.fromOffset(24, 158), Size = UDim2.new(1, -48, 0, 38),
        })
        local boxBg = new("Frame", {
            Position = UDim2.fromOffset(24, 208), Size = UDim2.new(1, -48, 0, 42), BorderSizePixel = 0,
            _theme = { BackgroundColor3 = "Field" },
        }, card)
        corner(boxBg, 10)
        local boxStroke = stroke(boxBg, "Stroke", 1)
        local box = new("TextBox", {
            BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -28, 1, 0),
            Font = Enum.Font.GothamMedium, TextSize = 14, PlaceholderText = "Paste your key here", ClearTextOnFocus = false,
            Text = "", TextXAlignment = Enum.TextXAlignment.Left,
            _theme = { TextColor3 = "Text", PlaceholderColor3 = "Muted" },
        }, boxBg)
        box.Focused:Connect(function() tween(boxStroke, FAST, { Color = Theme.Accent }) end)
        local submit = cardButton(card, "Unlock", true, {
            Position = UDim2.fromOffset(24, 262), Size = UDim2.new(1, -48, 0, 42),
        })
        local status = centerLabel(card, "Get the key in the 22 Hub Discord.", 316, 12, "Muted", Enum.Font.Gotham)
        local x = closeX(card)
        open()

        local copyBusy = false
        copy.MouseButton1Click:Connect(function()
            if copyBusy then return end
            copyBusy = true
            local okc = setclipboard and pcall(setclipboard, LINK)
            copy.Text = okc and "Copied! Paste it in your browser" or LINK
            task.delay(1.6, function()
                copy.Text = "Copy Discord link"
                copyBusy = false
            end)
        end)
        local function shake()
            local base = boxBg.Position
            for _, dx in ipairs({ -8, 7, -5, 4, -2, 0 }) do
                boxBg.Position = base + UDim2.fromOffset(dx, 0)
                task.wait(0.03)
            end
            boxBg.Position = base
        end
        local function try()
            if done then return end
            local typed = trim(box.Text):lower()
            if typed == REAL_KEY and REAL_KEY ~= "" then
                passed, done = true, true
                if SAVE_FILE then pcall(function() if writefile then writefile(SAVE_FILE, REAL_KEY) end end) end
                status.Text = "Unlocked"
                tween(status, FAST, { TextColor3 = Theme.Accent })
                tween(boxStroke, FAST, { Color = Theme.Accent })
                task.wait(0.25)
                close()
            else
                status.Text = "Wrong key. Get it in the Discord."
                status.TextColor3 = Color3.fromRGB(255, 120, 120)
                boxStroke.Color = Color3.fromRGB(255, 110, 110)
                task.spawn(shake)
                task.delay(1.2, function()
                    if not done then tween(boxStroke, EASE, { Color = Theme.Stroke }) end
                end)
            end
        end
        submit.MouseButton1Click:Connect(try)
        box.FocusLost:Connect(function(enter)
            if enter then try() else
                if not done then tween(boxStroke, FAST, { Color = Theme.Stroke }) end
            end
        end)
        x.MouseButton1Click:Connect(function()
            if done then return end
            done = true
            close()
        end)
        while not done and gui.Parent do task.wait(0.1) end
        while gui.Parent do task.wait(0.05) end
    end)
    if not ok then return passed end
    return passed
end

