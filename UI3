local PANEL_T = 0.08

local function makeOption(win, id, typ, default, normalize, visual, cfg, anchor)
    local o = { Type = typ, Value = normalize(default), _cbs = {}, _id = id }
    function o:OnChanged(f)
        self._cbs[#self._cbs + 1] = f
        return self
    end
    function o:SetValue(v, instant)
        v = normalize(v)
        self.Value = v
        visual(v, instant)
        if cfg and cfg.Callback then pcall(cfg.Callback, v) end
        for _, f in ipairs(self._cbs) do pcall(f, v) end
        if win and win._scheduleSave then win:_scheduleSave() end
    end
    visual(o.Value, true)
    if anchor then onTheme(anchor, function() visual(o.Value, true) end) end
    if id then Library.Options[id] = o end
    return o
end

