local themeListeners = {}
local function applyTheme(name, instant)
    local pal = Themes[name]
    if not pal then return end
    fillTheme(pal)
    local keep = {}
    for _, b in ipairs(Bound) do
        local o, prop, key = b[1], b[2], b[3]
        if o.Parent ~= nil then
            keep[#keep + 1] = b
            if instant or not Settings.Motion then
                pcall(function() o[prop] = Theme[key] end)
            else
                tween(o, THEME_FADE, { [prop] = Theme[key] })
            end
        end
    end
    Bound = keep
    local keepH = {}
    for _, h in ipairs(Hooks) do
        if h[1].Parent ~= nil then
            keepH[#keepH + 1] = h
            pcall(h[2], instant)
        end
    end
    Hooks = keepH
    for _, f in ipairs(themeListeners) do pcall(f) end
end

function Library:SetTheme(name)
    if not Themes[name] then return end
    Settings.Theme = name
    saveSettings()
    applyTheme(name, false)
end
function Library:GetTheme() return Settings.Theme end

local Ambient = {}
Ambient.__index = Ambient
local allAmbients = {}

local function rnd(a, b) return a + math.random() * (b - a) end

local function dot(parent, size, color, tr)
    local f = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(size, size),
        BackgroundColor3 = color, BackgroundTransparency = tr, BorderSizePixel = 0,
    }, parent)
    round(f)
    return f
end

local function glowOrb(parent, size, color, tr)
    local f = new("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 }, parent)
    for _, k in ipairs({ 1, 0.72, 0.45 }) do
        local c = new("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(k, k),
            BackgroundColor3 = color, BackgroundTransparency = tr, BorderSizePixel = 0,
        }, f)
        round(c)
    end
    return f
end

function Ambient.new(host, root, density)
    local self = setmetatable({ parts = {}, orbs = {}, t = 0, acc = 0, paused = false, density = density or 1, root = root }, Ambient)
    self.layer = new("Frame", { Name = "Ambient", BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), ClipsDescendants = true, ZIndex = 1 }, host)
    self.conn = RunService.Heartbeat:Connect(function(dt) self:_step(dt) end)
    allAmbients[#allAmbients + 1] = self
    self:Rebuild()
    return self
end

function Ambient:Clear()
    for _, p in ipairs(self.parts) do pcall(function() p.f:Destroy() end) end
    for _, o in ipairs(self.orbs) do pcall(function() o.f:Destroy() end) end
    self.parts, self.orbs = {}, {}
end

function Ambient:_orb(x, y, size, color, tr, amp, rate)
    self.orbs[#self.orbs + 1] = {
        f = glowOrb(self.layer, size, color, tr), x = x, y = y, s = size,
        a = amp or 0.04, r = rate or 0.15, ph = rnd(0, 6.28),
    }
end

function Ambient:Rebuild()
    self:Clear()
    local fx = Theme.Fx
    if not Settings.Effects or fx == "none" or not fx then
        self.layer.Visible = false
        return
    end
    self.layer.Visible = true
    local d = self.density
    local c1, c2 = Theme.FxColor, Theme.FxColor2
    if fx == "snow" then
        for _ = 1, math.floor(40 * d) do
            local s = math.random(2, 5)
            self.parts[#self.parts + 1] = {
                k = "snow", f = dot(self.layer, s, c1, rnd(0.15, 0.55)),
                x0 = math.random(), y = rnd(-0.05, 1.05), v = rnd(0.025, 0.05) * (0.6 + s / 6),
                sw = rnd(0.006, 0.02), fr = rnd(0.4, 1.1), ph = rnd(0, 6.28),
            }
        end
        self:_orb(0.72, 0.18, 230, c2, 0.955, 0.03, 0.12)
    elseif fx == "stars" then
        for _ = 1, math.floor(30 * d) do
            local p = {
                k = "star", f = dot(self.layer, math.random(1, 3), c1, 0.5),
                x = math.random(), y = math.random(), base = rnd(0.15, 0.55), rate = rnd(0.6, 1.8), ph = rnd(0, 6.28),
            }
            p.f.Position = UDim2.fromScale(p.x, p.y)
            self.parts[#self.parts + 1] = p
        end
        self:_orb(0.78, 0.28, 260, c2, 0.95, 0.05, 0.1)
        self:_orb(0.22, 0.78, 200, c2, 0.96, 0.05, 0.08)
    elseif fx == "embers" then
        for i = 1, math.floor(16 * d) do
            local s = math.random(2, 4)
            self.parts[#self.parts + 1] = {
                k = "ember", f = dot(self.layer, s, (i % 2 == 0) and c1 or c2, 0.4),
                x0 = math.random(), y = rnd(0, 1.1), v = rnd(0.018, 0.04), sw = rnd(0.01, 0.03),
                fr = rnd(0.3, 0.8), ph = rnd(0, 6.28), base = rnd(0.2, 0.45),
            }
        end
        self:_orb(0.2, 0.78, 280, c1, 0.94, 0.04, 0.1)
        self:_orb(0.8, 0.25, 220, c2, 0.95, 0.04, 0.12)
    elseif fx == "fireflies" then
        for _ = 1, math.floor(14 * d) do
            self.parts[#self.parts + 1] = {
                k = "fly", f = dot(self.layer, math.random(2, 4), c1, 0.5),
                x0 = rnd(0.05, 0.95), y0 = rnd(0.08, 0.95), ax = rnd(0.02, 0.06), ay = rnd(0.02, 0.05),
                rx = rnd(0.15, 0.4), ry = rnd(0.12, 0.35), rate = rnd(0.5, 1.4), ph = rnd(0, 6.28),
            }
        end
        self:_orb(0.5, 0.82, 300, c2, 0.955, 0.03, 0.08)
    end
    self:_step(1 / 30)
end

function Ambient:SetPaused(p) self.paused = p end

function Ambient:Destroy()
    if self.conn then pcall(function() self.conn:Disconnect() end) end
    self.conn = nil
    self:Clear()
    pcall(function() self.layer:Destroy() end)
    for i, a in ipairs(allAmbients) do if a == self then table.remove(allAmbients, i) break end end
end

function Ambient:_step(dt)
    if (self.root and self.root.Parent == nil) or self.layer.Parent == nil then self:Destroy() return end
    if self.paused or not self.layer.Visible then return end
    self.acc = self.acc + dt
    if self.acc < 1 / 30 then return end
    local step = math.min(self.acc, 0.25)
    self.acc = 0
    self.t = self.t + step
    local t = self.t
    for _, p in ipairs(self.parts) do
        local k = p.k
        if k == "snow" then
            p.y = p.y + p.v * step
            if p.y > 1.05 then p.y = -0.05; p.x0 = math.random() end
            p.f.Position = UDim2.fromScale(p.x0 + math.sin(t * p.fr + p.ph) * p.sw, p.y)
        elseif k == "star" then
            p.f.BackgroundTransparency = math.clamp(p.base + 0.35 * math.sin(t * p.rate + p.ph), 0, 0.95)
        elseif k == "ember" then
            p.y = p.y - p.v * step
            if p.y < -0.05 then p.y = 1.05; p.x0 = math.random() end
            p.f.Position = UDim2.fromScale(p.x0 + math.sin(t * p.fr + p.ph) * p.sw, p.y)
            p.f.BackgroundTransparency = math.clamp(p.base + (1 - p.y) * 0.5, 0, 1)
        elseif k == "fly" then
            p.f.Position = UDim2.fromScale(p.x0 + math.sin(t * p.rx + p.ph) * p.ax, p.y0 + math.cos(t * p.ry + p.ph) * p.ay)
            p.f.BackgroundTransparency = math.clamp(0.55 + 0.42 * math.sin(t * p.rate + p.ph), 0.1, 0.97)
        end
    end
    for _, o in ipairs(self.orbs) do
        o.f.Position = UDim2.fromScale(o.x + math.sin(t * o.r + o.ph) * o.a, o.y + math.cos(t * o.r * 0.8 + o.ph) * o.a)
        local s = o.s * (1 + 0.07 * math.sin(t * o.r * 1.6 + o.ph))
        o.f.Size = UDim2.fromOffset(s, s)
    end
end

