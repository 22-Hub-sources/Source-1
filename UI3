local function overlayCard(name, order, w, h)
    local gui = makeGui(name, order)
    local dim = new("Frame", {
        Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, BackgroundTransparency = 1, Active = true,
        _theme = { BackgroundColor3 = "Bg2" },
    }, gui)
    local amb = Ambient.new(dim, gui, 1.5)
    local scaler = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(w, h),
        BackgroundTransparency = 1, ZIndex = 5,
    }, dim)
    local fit = new("UIScale", { Scale = fitScale(w, h, 32) }, scaler)
    local card = new("Frame", {
        Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.04, BorderSizePixel = 0,
    }, scaler)
    corner(card, 18)
    bgGradient(card, 90)
    stroke(card, "Stroke", 1)
    local pop = new("UIScale", { Scale = 1 }, card)
    local vpConn
    pcall(function()
        vpConn = workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
            fit.Scale = fitScale(w, h, 32)
        end)
    end)

    local snap
    local function open()
        snap = snapshot(card)
        fadeSnap(snap, true)
        pop.Scale = 0.94
        card.Position = UDim2.fromOffset(0, 14)
        tween(dim, SLOW, { BackgroundTransparency = 0.18 })
        tween(pop, SLOW, { Scale = 1 })
        tween(card, SLOW, { Position = UDim2.fromOffset(0, 0) })
        fadeSnap(snap, false, SLOW)
    end
    local function close()
        snap = snapshot(card)
        tween(pop, EASE, { Scale = 1.03 })
        fadeSnap(snap, true, EASE)
        tween(dim, EASE, { BackgroundTransparency = 1 })
        if Settings.Motion then task.wait(0.26) end
        if vpConn then pcall(function() vpConn:Disconnect() end) end
        pcall(function() amb:Destroy() end)
        pcall(function() gui:Destroy() end)
    end
    return gui, card, open, close
end

