    badge.Position = UDim2.fromOffset(16, 18)
    badge.ZIndex = 3
    local titleLbl = label(brand, cfg.Title or "22 Hub", 16, "Text", Enum.Font.GothamBlack, {
        Position = UDim2.fromOffset(62, 18), Size = UDim2.new(1, -72, 0, 18), ZIndex = 3, TextTruncate = Enum.TextTruncate.AtEnd,
    })
    local subLbl = label(brand, cfg.SubTitle or "", 12, "Sub", Enum.Font.GothamMedium, {
        Position = UDim2.fromOffset(62, 37), Size = UDim2.new(1, -72, 0, 16), ZIndex = 3, TextTruncate = Enum.TextTruncate.AtEnd,
    })
    label(side, "MENU", 10, "Muted", Enum.Font.GothamBold, { Position = UDim2.fromOffset(20, HEAD + 14), Size = UDim2.new(1, -40, 0, 14), ZIndex = 3 })

    local FOOT = 62
    local tabList = new("ScrollingFrame", {
        BackgroundTransparency = 1, BorderSizePixel = 0, Position = UDim2.fromOffset(0, HEAD + 32),
        Size = UDim2.new(1, 0, 1, -(HEAD + 32 + FOOT)), ZIndex = 3,
        CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollBarThickness = 0,
    }, side)
    pad(tabList, 2, 10, 10, 10)
    list(tabList, 4)

    local foot = new("Frame", { BackgroundTransparency = 1, Position = UDim2.new(0, 0, 1, -FOOT), Size = UDim2.new(1, 0, 0, FOOT), ZIndex = 3 }, side)
    new("Frame", { Position = UDim2.fromOffset(14, 0), Size = UDim2.new(1, -28, 0, 1), BorderSizePixel = 0, ZIndex = 3, BackgroundTransparency = 0.2, _theme = { BackgroundColor3 = "Stroke" } }, foot)
    local avatar = new("ImageLabel", {
        Position = UDim2.fromOffset(16, 15), Size = UDim2.fromOffset(32, 32), BorderSizePixel = 0, ZIndex = 3,
        _theme = { BackgroundColor3 = "Panel" },
    }, foot)
    round(avatar)
    stroke(avatar, "Accent", 1.5, 0.3)
    local lp = Players.LocalPlayer
    label(foot, lp and lp.DisplayName or "Player", 13, "Text", Enum.Font.GothamBold, {
        Position = UDim2.fromOffset(56, 15), Size = UDim2.new(1, -66, 0, 16), ZIndex = 3, TextTruncate = Enum.TextTruncate.AtEnd,
    })
    local toggleKey = cfg.ToggleKey or Enum.KeyCode.LeftControl
    local keyName = (toggleKey and toggleKey.Name) or ""
    local hint = (keyName ~= "" and keyName ~= "World95" and keyName ~= "Unknown") and (keyName .. " to hide") or ("22 Hub v" .. Library.Version)
    label(foot, hint, 11, "Muted", Enum.Font.GothamMedium, {
        Position = UDim2.fromOffset(56, 32), Size = UDim2.new(1, -66, 0, 14), ZIndex = 3, TextTruncate = Enum.TextTruncate.AtEnd,
    })
    task.spawn(function()
        if not lp then return end
        local ok, img = pcall(function()
            return Players:GetUserThumbnailAsync(lp.UserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size48x48)
        end)
        if ok and img and avatar.Parent then avatar.Image = img end
    end)

    local contentArea = new("Frame", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(SIDE, 0), Size = UDim2.new(1, -SIDE, 1, 0), ZIndex = 2,
    }, main)
    local header = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, HEAD), ZIndex = 3 }, contentArea)
    local pageTitle = label(header, "", 20, "Text", Enum.Font.GothamBold, {
        Position = UDim2.fromOffset(22, 18), Size = UDim2.new(1, -120, 0, 24), ZIndex = 3, TextTruncate = Enum.TextTruncate.AtEnd,
    })
    new("Frame", {
        Position = UDim2.new(0, 18, 1, -1), Size = UDim2.new(1, -36, 0, 1), BorderSizePixel = 0, ZIndex = 3,
        BackgroundTransparency = 0.3, _theme = { BackgroundColor3 = "Stroke" },
    }, header)

    local function topButton(text, xOffset, danger)
        local b = new("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, xOffset, 0.5, 0), Size = UDim2.fromOffset(30, 30),
            BorderSizePixel = 0, Font = Enum.Font.GothamBold, TextSize = text == "×" and 18 or 14, BackgroundTransparency = 0.2,
            Text = text, AutoButtonColor = false, ZIndex = 4, _theme = { BackgroundColor3 = "Panel", TextColor3 = "Sub" },
        }, header)
        corner(b, 9)
        b.MouseEnter:Connect(function()
            tween(b, FAST, { BackgroundColor3 = danger and Color3.fromRGB(232, 72, 85) or Theme.Hover, TextColor3 = danger and Color3.new(1, 1, 1) or Theme.Text })
        end)
        b.MouseLeave:Connect(function() tween(b, FAST, { BackgroundColor3 = Theme.Panel, TextColor3 = Theme.Sub }) end)
        return b
    end
    local closeBtn = topButton("×", -16, true)
    local miniBtn = topButton("", -52)
    local miniLine = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(11, 2),
        BorderSizePixel = 0, ZIndex = 5, _theme = { BackgroundColor3 = "Sub" },
    }, miniBtn)
    round(miniLine)

    local pages = new("Frame", {
        BackgroundTransparency = 1, Position = UDim2.fromOffset(0, HEAD), Size = UDim2.new(1, 0, 1, -HEAD),
        ClipsDescendants = true, ZIndex = 3,
    }, contentArea)

    do
        local dragging, startPos, startInput
        local function begin(input)
            if isPress(input) then
                dragging = true
                startInput = input.Position
                startPos = holder.Position
            end
        end
        header.InputBegan:Connect(begin)
        brand.InputBegan:Connect(begin)
        win:_connect(UIS.InputChanged, function(input)
            if dragging and isMove(input) then
                local d = input.Position - startInput
                holder.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end)
        win:_connect(UIS.InputEnded, function(input)
            if dragging and isPress(input) then dragging = false end
        end)
    end

    body.Position = UDim2.fromOffset(0, 16)
    tween(anim, SLOW, { Scale = 1 })
    tween(body, SLOW, { Position = UDim2.fromOffset(0, 0) })

    local pillBtn = new("TextButton", {
        AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -50), Size = UDim2.fromOffset(132, 36),
        BorderSizePixel = 0, Text = "", AutoButtonColor = false, Visible = false, ZIndex = 20,
        _theme = { BackgroundColor3 = "Panel" },
    }, gui)
    round(pillBtn)
    stroke(pillBtn, "Accent", 1, 0.2)
    local pb = logoBadge(pillBtn, 24, 12)
    pb.Position = UDim2.fromOffset(6, 6)
    pb.ZIndex = 21
    label(pillBtn, cfg.Title or "22 Hub", 13, "Text", Enum.Font.GothamBold, {
        Position = UDim2.fromOffset(38, 0), Size = UDim2.new(1, -46, 1, 0), ZIndex = 21,
    })
    local visible = true
    function win:Toggle(show)
        if show == nil then show = not visible end
        if show == visible then return end
        visible = show
        if show then
            holder.Visible = true
            amb:SetPaused(false)
            tween(anim, SLOW, { Scale = 1 })
            tween(body, SLOW, { Position = UDim2.fromOffset(0, 0) })
            tween(pillBtn, EASE, { Position = UDim2.new(0.5, 0, 0, -50) })
            task.delay(0.22, function() if visible then pillBtn.Visible = false end end)
        else
            tween(anim, EASE, { Scale = 0.94 })
            tween(body, EASE, { Position = UDim2.fromOffset(0, 16) })
            pillBtn.Visible = true
            tween(pillBtn, SLOW, { Position = UDim2.new(0.5, 0, 0, 14) })
            task.delay(0.2, function()
                if not visible then
                    holder.Visible = false
                    amb:SetPaused(true)
                end
            end)
        end
    end
    miniBtn.MouseButton1Click:Connect(function() win:Toggle(false) end)
    pillBtn.MouseButton1Click:Connect(function() win:Toggle(true) end)
    win:_connect(UIS.InputBegan, function(input, processed)
        if not processed and input.KeyCode == toggleKey then win:Toggle() end
    end)

    function win:Destroy()
        for _, c in ipairs(self._conns) do pcall(function() c:Disconnect() end) end
        self._conns = {}
        pcall(function() amb:Destroy() end)
        pcall(function() gui:Destroy() end)
        toastHolder = nil
        Library._gui = nil
    end
    local closing = false
    closeBtn.MouseButton1Click:Connect(function()
        if closing then return end
        closing = true
        tween(anim, EASE, { Scale = 0.92 })
        tween(body, EASE, { Position = UDim2.fromOffset(0, 18) })
        tween(mainStroke, EASE, { Transparency = 1 })
        task.delay(0.2, function() win:Destroy() end)
    end)

    function win:SetTitle(sub)
        subLbl.Text = sub
    end

    function win:SelectTab(which)
        local tab = type(which) == "number" and self._tabs[which] or which
        if not tab then return end
        local changed = self._current ~= tab
        for _, t in ipairs(self._allTabs) do
            local on = (t == tab)
            t.page.Visible = on
            tween(t.hl, EASE, { BackgroundTransparency = on and 0 or 1 })
            tween(t.text, FAST, { TextColor3 = on and Theme.Text or Theme.Sub })
            tween(t.bar, BOUNCE, { Size = UDim2.fromOffset(3, on and 18 or 0) })
        end
        self._current = tab
        pageTitle.Text = tab.title
        if changed then
            tab.page.Position = UDim2.fromOffset(0, 14)
            tween(tab.page, SLOW, { Position = UDim2.fromOffset(0, 0) })
            pageTitle.TextTransparency = 1
            pageTitle.Position = UDim2.fromOffset(30, 18)
            tween(pageTitle, EASE, { TextTransparency = 0, Position = UDim2.fromOffset(22, 18) })
        end
    end
    onTheme(header, function()
        for _, t in ipairs(win._allTabs) do t.text.TextColor3 = (t == win._current) and Theme.Text or Theme.Sub end
    end)

    local function makeTab(tcfg, order, internal)
        tcfg = tcfg or {}
        local tab = setmetatable({ _win = win, _order = 0, title = tcfg.Title or "Tab" }, Container)
        local button = new("TextButton", {
            Size = UDim2.new(1, 0, 0, 38), BackgroundTransparency = 1, BorderSizePixel = 0, Text = "",
            AutoButtonColor = false, LayoutOrder = order, ZIndex = 3,
        }, tabList)
        local hl = new("Frame", {
            Size = UDim2.fromScale(1, 1), BorderSizePixel = 0, BackgroundTransparency = 1, ZIndex = 3,
            _theme = { BackgroundColor3 = "Hover" },
        }, button)
        corner(hl, 10)
        local bar = new("Frame", {
            AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 0, 0.5, 0), Size = UDim2.fromOffset(3, 0),
            BorderSizePixel = 0, ZIndex = 4, BackgroundColor3 = Color3.new(1, 1, 1),
        }, button)
        round(bar)
        accentGradient(bar, 90)
        local text = label(button, tab.title, 14, "Sub", Enum.Font.GothamMedium, {
            Position = UDim2.fromOffset(16, 0), Size = UDim2.new(1, -24, 1, 0), ZIndex = 4, TextTruncate = Enum.TextTruncate.AtEnd,
        })
        local page = new("ScrollingFrame", {
            BackgroundTransparency = 1, BorderSizePixel = 0, Size = UDim2.fromScale(1, 1), Visible = false, ZIndex = 3,
            CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 3, ScrollBarImageTransparency = 0.3, _theme = { ScrollBarImageColor3 = "Accent" },
        }, pages)
        pad(page, 14, 18, 18, 18)
        list(page, 10)
        tab._frame = page
        tab._scroll = page
        tab.page, tab.button, tab.bar, tab.hl, tab.text = page, button, bar, hl, text
        win._allTabs[#win._allTabs + 1] = tab
        if not internal then win._tabs[#win._tabs + 1] = tab end
        button.MouseButton1Click:Connect(function() win:SelectTab(tab) end)
        button.MouseEnter:Connect(function()
            if win._current ~= tab then
                tween(hl, FAST, { BackgroundTransparency = 0.55 })
                tween(text, FAST, { TextColor3 = Theme.Text })
            end
        end)
        button.MouseLeave:Connect(function()
            if win._current ~= tab then
                tween(hl, FAST, { BackgroundTransparency = 1 })
                tween(text, FAST, { TextColor3 = Theme.Sub })
            end
        end)
        return tab
    end

    function win:AddTab(tcfg)
        local tab = makeTab(tcfg, #win._tabs + 1, false)
        if #win._tabs == 1 then win:SelectTab(tab) end
        return tab
    end

    do
        local ap = makeTab({ Title = "Appearance" }, 100000, true)
        local s1 = ap:AddSection("Theme")
        local repaint
        repaint = s1:_themePicker(function(name)
            Library:SetTheme(name)
            repaint()
        end)
        local s2 = ap:AddSection("Animations")
        s2:AddToggle(nil, {
            Title = "Background animations", Description = "Snow, stars, embers and fireflies behind the menu. Turn off for the most FPS.",
            Default = Settings.Effects, Callback = function(v) if v ~= Settings.Effects then setEffects(v) end end,
        })
        s2:AddToggle(nil, {
            Title = "Smooth animations", Description = "Sliding tabs, hover effects and transitions. Turn off for instant changes.",
            Default = Settings.Motion, Callback = function(v) Settings.Motion = v; saveSettings() end,
        })
        local s3 = ap:AddSection("Size")
        local scaleTimer = 0
        s3:AddSlider(nil, {
            Title = "Menu size", Description = "Makes the whole menu bigger or smaller. It also shrinks on its own to fit small screens.",
            Min = 70, Max = 130, Default = Settings.Scale, Rounding = 0, Suffix = "%",
            Callback = function(v)
                Settings.Scale = v
                refit()
                scaleTimer = scaleTimer + 1
                local mine = scaleTimer
                task.delay(0.6, function() if mine == scaleTimer then saveSettings() end end)
            end,
        })
        local s4 = ap:AddSection("About")
        s4:AddParagraph({
            Title = "22 Hub v" .. Library.Version,
            Content = "Your theme and animation choices are shared by every 22 Hub script. Join the Discord for updates: discord.gg/" .. INVITE_CODE,
        })
    end

    function win:_path() return self.Folder and (self.Folder .. "/config.json") or nil end
    function win:_scheduleSave()
        if not self:_path() or self._saveQueued or not writefile then return end
        self._saveQueued = true
        task.delay(0.6, function()
            self._saveQueued = false
            local data = {}
            for id, o in pairs(Library.Options) do
                if not (o.NoSave) then data[id] = o.Value end
            end
            pcall(function()
                if makefolder and isfolder then
                    local folder = string.match(self.Folder, "^[^/\\]+")
                    if folder and not isfolder(folder) then makefolder(folder) end
                    if not isfolder(self.Folder) then makefolder(self.Folder) end
                end
                writefile(self:_path(), HttpService:JSONEncode(data))
            end)
        end)
    end
    function win:LoadConfig()
        local path = self:_path()
        if not path or not (isfile and readfile) then return false end
        local ok, data = pcall(function()
            if not isfile(path) then return nil end
            return HttpService:JSONDecode(readfile(path))
        end)
        if not ok or type(data) ~= "table" then return false end
        for id, v in pairs(data) do
            local o = Library.Options[id]
            if o and not o.NoSave then pcall(function() o:SetValue(v, true) end) end
        end
        return true
    end

    function win:Notify(n) Library:Notify(n) end
    local _ = titleLbl
    return win
end

return Library
