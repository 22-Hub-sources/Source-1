function Container:AddSlider(id, cfg)
    cfg = cfg or {}
    local min, max = cfg.Min or 0, cfg.Max or 100
    local digits = cfg.Rounding or 0
    local row, rs = makeRow(self)
    list(row, 0)
    local topWrap = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), LayoutOrder = 0 }, row)
    local valuePill = pill(topWrap, 64, 24)
    valuePill.AnchorPoint = Vector2.new(1, 0)
    valuePill.Position = UDim2.new(1, -16, 0, 11)
    valuePill.AutomaticSize = Enum.AutomaticSize.X
    valuePill.Size = UDim2.fromOffset(0, 24)
    valuePill.TextXAlignment = Enum.TextXAlignment.Center
    local holder = textBlock(row, cfg.Title, cfg.Description, 96)
    holder.LayoutOrder = 1
    local area = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30), LayoutOrder = 2 }, row)
    local bar = new("Frame", {
        AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 16, 0.5, -5), Size = UDim2.new(1, -32, 0, 6),
        BorderSizePixel = 0, _theme = { BackgroundColor3 = "Off" },
    }, area)
    round(bar)
    local fill = new("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0 }, bar)
    round(fill)
    accentGradient(fill, 0)
    local knob = new("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(14, 14),
        BackgroundColor3 = Color3.new(1, 1, 1), BorderSizePixel = 0, ZIndex = 2,
    }, fill)
    round(knob)
    stroke(knob, "Accent", 2)
    local hit = new("TextButton", {
        BackgroundTransparency = 1, Text = "", Size = UDim2.new(1, -16, 0, 30), Position = UDim2.fromOffset(8, 0), ZIndex = 3, AutoButtonColor = false,
    }, area)

    local fmt = "%." .. tostring(digits) .. "f"
    local opt
    opt = makeOption(self._win, id, "Slider", cfg.Default or min, function(v)
        v = tonumber(v) or min
        return roundTo(math.clamp(v, min, max), digits)
    end, function(v, instant)
        valuePill.Text = string.format(fmt, v) .. (cfg.Suffix or "")
        local a = (max > min) and ((v - min) / (max - min)) or 0
        if instant == true then
            fill.Size = UDim2.fromScale(a, 1)
        else
            tween(fill, FAST, { Size = UDim2.fromScale(a, 1) })
        end
    end, cfg)

    local dragging = false
    local function setFromX(x)
        local w = bar.AbsoluteSize.X
        if w <= 0 then return end
        local a = math.clamp((x - bar.AbsolutePosition.X) / w, 0, 1)
        local v = roundTo(min + (max - min) * a, digits)
        if v ~= opt.Value then opt:SetValue(v) end
    end
    hit.InputBegan:Connect(function(input)
        if isPress(input) then
            dragging = true
            if self._scroll then self._scroll.ScrollingEnabled = false end
            tween(knob, FAST, { Size = UDim2.fromOffset(18, 18) })
            setFromX(input.Position.X)
        end
    end)
    self._win:_connect(UIS.InputChanged, function(input)
        if dragging and isMove(input) then setFromX(input.Position.X) end
    end)
    self._win:_connect(UIS.InputEnded, function(input)
        if dragging and isPress(input) then
            dragging = false
            if self._scroll then self._scroll.ScrollingEnabled = true end
            tween(knob, BOUNCE, { Size = UDim2.fromOffset(14, 14) })
        end
    end)
    hoverable(row, hit, rs)
    return opt
end

function Container:AddDropdown(id, cfg)
    cfg = cfg or {}
    local values = cfg.Values or {}
    local default = cfg.Default
    if type(default) == "number" then default = values[default] end
    if default == nil then default = values[1] end

    local ITEM = 32
    local HEAD = 50
    local row, rs = makeRow(self)
    row.AutomaticSize = Enum.AutomaticSize.None
    row.ClipsDescendants = true
    row.Size = UDim2.new(1, 0, 0, HEAD)
    local head = new("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, HEAD) }, row)
    textBlock(head, cfg.Title, nil, 170)
    local valuePill = pill(head, 140, 26)
    valuePill.Position = UDim2.new(1, -40, 0.5, 0)
    valuePill.TextXAlignment = Enum.TextXAlignment.Right
    valuePill.BackgroundTransparency = 1
    local arrow = label(head, ">", 14, "Sub", Enum.Font.GothamBold, {
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -14, 0.5, 0), Size = UDim2.fromOffset(18, 20),
        TextXAlignment = Enum.TextXAlignment.Center,
    })
    local hit = new("TextButton", { BackgroundTransparency = 1, Text = "", Size = UDim2.fromScale(1, 1), ZIndex = 3, AutoButtonColor = false }, head)

    local shown = math.min(#values, 6)
    local listH = shown * ITEM
    local box = new("Frame", {
        Position = UDim2.fromOffset(10, HEAD), Size = UDim2.new(1, -20, 0, listH + 8), BorderSizePixel = 0,
        _theme = { BackgroundColor3 = "Field" },
    }, row)
    corner(box, 8)
    local scroll = new("ScrollingFrame", {
        BackgroundTransparency = 1, BorderSizePixel = 0,
        Position = UDim2.fromOffset(4, 4), Size = UDim2.new(1, -8, 0, listH),
        CanvasSize = UDim2.new(0, 0, 0, #values * ITEM),
        ScrollBarThickness = 2, _theme = { ScrollBarImageColor3 = "Accent" },
    }, box)
    list(scroll, 0)

    local items = {}
    local opt
    local function paintItem(name, b, instant)
        local sel = (name == (opt and opt.Value))
        local goal = { TextColor3 = sel and Theme.Accent2 or Theme.Sub, BackgroundTransparency = sel and 0 or 1 }
        if instant then for k, v in pairs(goal) do b[k] = v end else tween(b, FAST, goal) end
    end
    opt = makeOption(self._win, id, "Dropdown", default, function(v)
        for _, x in ipairs(values) do if x == v then return v end end
        return values[1]
    end, function(v, instant)
        valuePill.Text = tostring(v)
        for name, b in pairs(items) do paintItem(name, b, instant) end
    end, cfg, row)

    local open = false
    local function setOpen(v)
        open = v
        tween(row, EASE, { Size = UDim2.new(1, 0, 0, v and (HEAD + listH + 18) or HEAD) })
        tween(arrow, EASE, { Rotation = v and 90 or 0 })
        tween(arrow, FAST, { TextColor3 = v and Theme.Accent2 or Theme.Sub })
    end
    local function makeItem(i, name)
        local b = new("TextButton", {
            BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, ITEM), LayoutOrder = i,
            Font = Enum.Font.GothamMedium, TextSize = 13, Text = tostring(name),
            TextXAlignment = Enum.TextXAlignment.Left, AutoButtonColor = false, BorderSizePixel = 0,
            TextColor3 = Theme.Sub, _theme = { BackgroundColor3 = "Hover" },
        }, scroll)
        corner(b, 6)
        pad(b, 0, 8, 0, 10)
        items[name] = b
        b.MouseEnter:Connect(function() if name ~= opt.Value then tween(b, FAST, { BackgroundTransparency = 0.5, TextColor3 = Theme.Text }) end end)
        b.MouseLeave:Connect(function() paintItem(name, b) end)
        b.MouseButton1Click:Connect(function()
            opt:SetValue(name)
            setOpen(false)
        end)
        paintItem(name, b, true)
        return b
    end
    for i, name in ipairs(values) do makeItem(i, name) end
    hit.MouseButton1Click:Connect(function() setOpen(not open) end)
    hoverable(row, hit, rs)

    function opt:SetValues(newValues)

        for _, b in pairs(items) do b:Destroy() end
        items = {}
        values = newValues
        shown = math.min(#values, 6)
        listH = shown * ITEM
        scroll.Size = UDim2.new(1, -8, 0, listH)
        box.Size = UDim2.new(1, -20, 0, listH + 8)
        scroll.CanvasSize = UDim2.new(0, 0, 0, #values * ITEM)
        for i, name in ipairs(values) do makeItem(i, name) end
        if open then row.Size = UDim2.new(1, 0, 0, HEAD + listH + 18) end
        opt:SetValue(values[1], true)
    end
    return opt
end

